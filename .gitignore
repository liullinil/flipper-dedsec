# Personal device backup: NFC/RFID/SubGHz dumps, badusb, apps_data incl. TOTP secrets.
# NEVER publish this.
backup/

# Build artifacts
apps/dedsec_uplink/dist/
apps/dedsec_uplink/.vscode/
apps/*/dist/
apps/*/.vscode/
build/
dist/
**/__pycache__/
*.pyc

# Local scratch / logs
*.log
scratchpad/

# companion build output (the .exe is attached to releases)
uplink/build/
uplink/dist_exe/
uplink/dist/
uplink/DedSecUplink.spec
uplink/DedSecUplinkConsole.spec

# screen renderer (tools/uplink_render): downloaded u8g2 sources and build output
tools/uplink_render/u8g2/
tools/uplink_render/obj/
tools/uplink_render/out/
tools/uplink_render/render.exe

# local agent worktrees
.claude/

# native Claude Code hook (built by uplink/hook/build.bat, bundled into the .exe)
uplink/hook/uplink_hook.exe
